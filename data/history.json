 "bios": {
  "lance": {
   "tag": "The Chalk Merchant",
   "take": "Lays the points and doesn't look back. He has never played a total, and the rare times he takes points he's 0–2. Alabama is his security blanket (unbeaten, one push) and Clemson went 4-for-4 in Year 1. Rode a nine-pick heater from late Year 2 into Year 3, then followed it with five straight misses."
  },
  "micah": {
   "tag": "The Long Shot",
   "take": "The moneyline is home, and it's the one place he's a winner. Spreads and totals are another story: laying points has gone 2–8 and he's 0-for-3 on totals. Fearless with big numbers: took Washington State +32.5 and cashed it, then took UCLA +30.5 and didn't."
  },
  "michael": {
   "tag": "The Closer",
   "take": "The house's best all-time record, and he's improved every season (6–6, then 10–5, then 8–2). Mostly favorites, a perfect record on unders, and a BYU believer who has never lost with the Cougars."
  },
  "patrick": {
   "tag": "Dog Walker",
   "take": "Takes the points. Getting points and playing moneylines carry him, while laying points has been a loser. Went from 4–8 in Year 1 to 8–1 in Year 3, the best single season anyone in the house has had. Tennessee keeps burning him."
  },
  "noah": {
   "tag": "Big Swing",
   "take": "Joined in Year 2 and has stayed over .500 every season. Likes a moneyline and isn't scared of a huge number: laid 32.5 with Ohio State, which missed, and the Buckeyes have burned him twice. New Mexico is his mid-major crush this year."
  },
  "seth": {
   "tag": "Over Man",
   "take": "Joined midway through Year 2. Mostly a favorites guy, and when he plays a total it's always the over. Year 3 has been his best run yet."
  }
 }
